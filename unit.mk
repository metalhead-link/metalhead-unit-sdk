# Shared build rules for loadable units. A unit file is a bundle of plugins; its Makefile sets
# NAME (the output file), BUNDLE (the name on the device: /units/<BUNDLE>.unt), PLUGINS (the
# UnitPluginEntry function of each plugin, in order) and SRCS, and includes this file:
#
#   NAME := vumeter
#   BUNDLE := VUMeter
#   PLUGINS := vumeter_plugin
#   SRCS := vumeter.c
#   include ../unit.mk
#
# SRCS may name sources in other unit directories (see all/Makefile). unit_entry() comes from
# a generated build/bundle.c (UNIT_BUNDLE in unit_abi.h).
#
# Output, one per board (upload the one for yours with the web UI, or copy it to /units/
# on the SD card):
#   build/arm32/$(NAME).unt      BeagleBone Black
#   build/aarch64/$(NAME).unt    Raspberry Pi 5
# `make arm32` or `make aarch64` builds just one.

UNITS_DIR := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))

# BeagleBone Black: the same toolchain and libgcc variant as the firmware (ARM, not Thumb;
# see LD_OPTS in wormhole/Makefile)
CROSSPATH ?= /Applications/ARM/bin
CC_arm32 := $(CROSSPATH)/arm-none-eabi-gcc
OBJDUMP_arm32 := $(CROSSPATH)/arm-none-eabi-objdump
LIBGCC_arm32 ?= /Applications/ARM/lib/gcc/arm-none-eabi/14.3.1/arm/v5te/hard/libgcc.a
CFLAGS_arm32 := -mcpu=cortex-a8 -mfpu=neon -mfloat-abi=hard -marm

# Raspberry Pi 5: the same toolchain as rpi5/metalhead
CROSSPATH_AARCH64 ?= /Applications/ArmGNUToolchain/15.3.rel2/aarch64-none-elf/bin
CC_aarch64 := $(CROSSPATH_AARCH64)/aarch64-none-elf-gcc
OBJDUMP_aarch64 := $(CROSSPATH_AARCH64)/aarch64-none-elf-objdump
LIBGCC_aarch64 ?= $(shell $(CC_aarch64) -print-libgcc-file-name)
CFLAGS_aarch64 := -mcpu=cortex-a76

CFLAGS := -O2 -g -Wall -std=gnu11 \
		-fpie -ffreestanding -fno-common -fno-builtin-printf \
		-fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
		-ffunction-sections -fdata-sections \
		-I$(UNITS_DIR)/include $(EXTRA_CFLAGS)

LDFLAGS := -nostdlib -nostartfiles -pie \
		-Wl,--no-dynamic-linker -Wl,-T,$(UNITS_DIR)/unit.ld -Wl,--gc-sections \
		-Wl,-z,max-page-size=16 -Wl,--build-id=none -Wl,--no-warn-rwx-segments

MACHINES := arm32 aarch64

ifeq ($(strip $(BUNDLE)),)
$(error $(NAME): set BUNDLE, the unit file's name on the device)
endif
ifeq ($(strip $(PLUGINS)),)
$(error $(NAME): set PLUGINS, the plugin entry functions)
endif

empty :=
comma := ,
space := $(empty) $(empty)

# Objects are named after their source file, wherever it is (see SOURCE_RULE)
OBJS := $(notdir $(SRCS:.c=.o)) bundle.o

all: $(MACHINES)

build/bundle.c: Makefile $(UNITS_DIR)/unit.mk
	@mkdir -p build
	printf '/* Generated by unit.mk from Makefile */\n#include <unit_abi.h>\n' > $@
	for p in $(PLUGINS); do printf 'UnitPluginEntry %s;\n' $$p >> $@; done
	printf 'UNIT_BUNDLE("%s", %s);\n' '$(BUNDLE)' '$(subst $(space),$(comma) ,$(strip $(PLUGINS)))' >> $@

# $(1) machine, $(2) source file
define SOURCE_RULE
build/$(1)/$(notdir $(2:.c=.o)): $(2) $(UNITS_DIR)/include/unit_abi.h
	@mkdir -p $$(dir $$@)
	$(CC_$(1)) $(CFLAGS_$(1)) $(CFLAGS) -c -o $$@ $$<
endef
$(foreach m,$(MACHINES),$(foreach s,$(SRCS) build/bundle.c,$(eval $(call SOURCE_RULE,$(m),$(s)))))

define MACHINE_RULES
$(1): build/$(1)/$(NAME).unt

# No loop-to-memcpy/memset pattern matching here: it would turn these into calls to themselves.
build/$(1)/unitrt.o: $(UNITS_DIR)/common/unitrt.c
	@mkdir -p $$(dir $$@)
	$(CC_$(1)) $(CFLAGS_$(1)) $(CFLAGS) -fno-tree-loop-distribute-patterns -c -o $$@ $$<

build/$(1)/$(NAME).elf: $(addprefix build/$(1)/,$(OBJS)) build/$(1)/unitrt.o $(UNITS_DIR)/unit.ld
	$(CC_$(1)) $(CFLAGS_$(1)) $(CFLAGS) $(LDFLAGS) -o $$@ $$(filter %.o,$$^) $(LIBGCC_$(1))

build/$(1)/$(NAME).unt: build/$(1)/$(NAME).elf $(UNITS_DIR)/tools/mkunit.py
	python3 $(UNITS_DIR)/tools/mkunit.py $$< $$@

disasm-$(1): build/$(1)/$(NAME).elf
	$(OBJDUMP_$(1)) -d -r $$<
endef
$(foreach m,$(MACHINES),$(eval $(call MACHINE_RULES,$(m))))

# `make test`: the plugins compiled for the Mac and run through the ABI by tools/unittest.c,
# with the address and undefined-behaviour sanitizers. TEST_ARGS="-v -r <sd card folder>".
HOST_CC ?= clang
build/host/unittest: $(SRCS) build/bundle.c $(UNITS_DIR)/tools/unittest.c $(UNITS_DIR)/include/unit_abi.h
	@mkdir -p $(dir $@)
	$(HOST_CC) -O1 -g -Wall -std=gnu11 -fsanitize=address,undefined -fno-sanitize-recover=undefined \
		-I$(UNITS_DIR)/include -o $@ $(filter %.c,$^) -lm

test: build/host/unittest
	build/host/unittest $(TEST_ARGS)

clean:
	rm -rf build

.PHONY: all clean test $(MACHINES) $(foreach m,$(MACHINES),disasm-$(m))
