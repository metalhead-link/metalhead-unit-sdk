# Shared build rules for loadable units. A unit file is a bundle of plugins; its Makefile sets
# NAME (the output file), BUNDLE (the name on the device: /units/<BUNDLE>.unt), PLUGINS (the
# UnitPluginEntry function of each plugin, in order) and SRCS, and includes this file:
#
#   NAME := vumeter
#   BUNDLE := VUMeter
#   PLUGINS := vumeter_plugin
#   SRCS := vumeter.c
#   include ../unit.mk
#
# SRCS may name sources in other unit directories (see stock/Makefile), and C++ sources (.cc,
# .cpp). unit_entry() comes from a generated $(BUILD)/<machine>/bundle.c (UNIT_BUNDLE in
# unit_abi.h).
#
# Plugins for one board only (too heavy for the BeagleBone, say) go in PLUGINS_arm32 or
# PLUGINS_aarch64, with their sources in SRCS_arm32 or SRCS_aarch64; they come after PLUGINS
# in the bundle. LIBM := 1 links newlib's libm (sinf, powf, ...; see common/unitrt.c).
# FACEPLATES := Plugin=file.html ... puts plugins' faceplates into the file (doc/faceplates.md).
#
# Output, one per board (upload the one for yours with the web UI, or copy it to /units/
# on the SD card):
#   $(BUILD)/arm32/$(NAME).unt      BeagleBone Black
#   $(BUILD)/aarch64/$(NAME).unt    Raspberry Pi 5
# `make arm32` or `make aarch64` builds just one.

UNITS_DIR := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))

# BeagleBone Black: the same toolchain and libgcc variant as the firmware (ARM, not Thumb;
# see LD_OPTS in metalhead-firmware's ccs/wormhole/Makefile)
CROSSPATH ?= /Applications/ARM/bin
CC_arm32 := $(CROSSPATH)/arm-none-eabi-gcc
OBJDUMP_arm32 := $(CROSSPATH)/arm-none-eabi-objdump
LIBGCC_arm32 ?= /Applications/ARM/lib/gcc/arm-none-eabi/14.3.1/arm/v5te/hard/libgcc.a
CFLAGS_arm32 := -mcpu=cortex-a8 -mfpu=neon -mfloat-abi=hard -marm

# Raspberry Pi 5: the same toolchain as metalhead-firmware's rpi5/metalhead
CROSSPATH_AARCH64 ?= /Applications/ArmGNUToolchain/15.3.rel2/aarch64-none-elf/bin
CC_aarch64 := $(CROSSPATH_AARCH64)/aarch64-none-elf-gcc
OBJDUMP_aarch64 := $(CROSSPATH_AARCH64)/aarch64-none-elf-objdump
LIBGCC_aarch64 ?= $(shell $(CC_aarch64) -print-libgcc-file-name)
CFLAGS_aarch64 := -mcpu=cortex-a76

CXX_arm32 := $(CROSSPATH)/arm-none-eabi-g++
LIBM_arm32 ?= /Applications/ARM/arm-none-eabi/lib/arm/v5te/hard/libm.a
CXX_aarch64 := $(CROSSPATH_AARCH64)/aarch64-none-elf-g++
LIBM_aarch64 ?= $(shell $(CC_aarch64) -print-file-name=libm.a)

COMMON_FLAGS := -O2 -g -Wall \
		-fpie -fno-common \
		-fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
		-ffunction-sections -fdata-sections \
		-I$(UNITS_DIR)/include

CFLAGS := $(COMMON_FLAGS) -std=gnu11 -ffreestanding -fno-builtin-printf $(EXTRA_CFLAGS)

# Not -ffreestanding: it takes away <cmath> and <algorithm>. The headers are fine, it's only the
# C and C++ libraries that units can't link. No RTTI, exceptions, thread-safe statics or atexit:
# each needs a runtime that units don't have.
CXXFLAGS := $(COMMON_FLAGS) -std=gnu++14 -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit \
		$(EXTRA_CXXFLAGS)

LDFLAGS := -nostdlib -nostartfiles -pie \
		-Wl,--no-dynamic-linker -Wl,-T,$(UNITS_DIR)/unit.ld -Wl,--gc-sections \
		-Wl,-z,max-page-size=16 -Wl,--build-id=none -Wl,--no-warn-rwx-segments

BUILD ?= build
MACHINES := arm32 aarch64

ifeq ($(strip $(BUNDLE)),)
$(error $(NAME): set BUNDLE, the unit file's name on the device)
endif
ifeq ($(strip $(PLUGINS) $(PLUGINS_arm32) $(PLUGINS_aarch64)),)
$(error $(NAME): set PLUGINS, the plugin entry functions)
endif

empty :=
comma := ,
space := $(empty) $(empty)

all: $(MACHINES)

# The sources and plugins of machine $(1); a source listed twice is compiled once
machine_srcs = $(sort $(SRCS) $(SRCS_$(1)))
machine_plugins = $(strip $(PLUGINS) $(PLUGINS_$(1)))

# Objects are named after the path of their source file (../vumeter/vumeter.c is
# vumeter_vumeter.o): many sources in a bigger tree share a file name.
obj = $(BUILD)/$(1)/$(subst /,_,$(subst ../,,$(basename $(2)))).o

# $(1) machine, $(2) source file
define SOURCE_RULE
$(call obj,$(1),$(2)): $(2) $(UNITS_DIR)/include/unit_abi.h
	@mkdir -p $$(dir $$@)
	$(if $(filter %.c,$(2)),$(CC_$(1)) $(CFLAGS_$(1)) $(CFLAGS),$(CXX_$(1)) $(CFLAGS_$(1)) $(CXXFLAGS)) -c -o $$@ $$<
endef
$(foreach m,$(MACHINES),$(foreach s,$(call machine_srcs,$(m)) $(BUILD)/$(m)/bundle.c,$(eval $(call SOURCE_RULE,$(m),$(s)))))

# bundle.c of each machine (and of the host test), with UNIT_BUNDLE for its plugins. The plugin
# list can change without a file changing (`make ONLY=...` in metalhead-mutable-units), so it's generated every
# time but only replaced when it differs: an unchanged one doesn't rebuild the unit.
$(BUILD)/%/bundle.c: FORCE
	@mkdir -p $(dir $@)
	@{ printf '/* Generated by unit.mk from Makefile */\n#include <unit_abi.h>\n'; \
	  for p in $(bundle_plugins); do printf 'UnitPluginEntry %s;\n' $$p; done; \
	  printf 'UNIT_BUNDLE("%s", %s);\n' '$(BUNDLE)' '$(subst $(space),$(comma) ,$(bundle_plugins))'; } > $@.new
	@if cmp -s $@.new $@; then rm $@.new; else mv $@.new $@; echo "generated $@"; fi
bundle_plugins = $(if $(filter host,$*),$(HOST_PLUGINS),$(call machine_plugins,$*))

FORCE:

define MACHINE_RULES
$(1): $(BUILD)/$(1)/$(NAME).unt

# No loop-to-memcpy/memset pattern matching here: it would turn these into calls to themselves.
$(BUILD)/$(1)/unitrt.o: $(UNITS_DIR)/common/unitrt.c
	@mkdir -p $$(dir $$@)
	$(CC_$(1)) $(CFLAGS_$(1)) $(CFLAGS) -fno-tree-loop-distribute-patterns -c -o $$@ $$<

$(BUILD)/$(1)/$(NAME).elf: $(foreach s,$(call machine_srcs,$(1)) $(BUILD)/$(1)/bundle.c,$(call obj,$(1),$(s))) \
		$(BUILD)/$(1)/unitrt.o $(UNITS_DIR)/unit.ld
	$(CC_$(1)) $(CFLAGS_$(1)) $(CFLAGS) $(LDFLAGS) -o $$@ $$(filter %.o,$$^) $(if $(LIBM),$(LIBM_$(1))) $(LIBGCC_$(1))

$(BUILD)/$(1)/$(NAME).unt: $(BUILD)/$(1)/$(NAME).elf $(UNITS_DIR)/tools/mkunit.py $(UNITS_DIR)/tools/unitfile.py \
		$(foreach f,$(FACEPLATES),$(lastword $(subst =, ,$(f))))
	python3 $(UNITS_DIR)/tools/mkunit.py $(foreach f,$(FACEPLATES),--faceplate $(f)) $$< $$@

disasm-$(1): $(BUILD)/$(1)/$(NAME).elf
	$(OBJDUMP_$(1)) -d -r $$<
endef
$(foreach m,$(MACHINES),$(eval $(call MACHINE_RULES,$(m))))

# `make test`: the plugins of both boards compiled for the Mac and run through the ABI by
# tools/unittest.c, with the address and undefined-behaviour sanitizers.
# TEST_ARGS="-v -r <sd card folder> -w <folder for WAV renders>".
HOST_CC ?= clang
HOST_CXX ?= clang++
HOST_FLAGS := -O1 -g -Wall -fsanitize=address,undefined -fno-sanitize-recover=undefined -I$(UNITS_DIR)/include
HOST_PLUGINS := $(strip $(PLUGINS) $(PLUGINS_arm32) $(PLUGINS_aarch64))
HOST_SRCS := $(sort $(SRCS) $(SRCS_arm32) $(SRCS_aarch64))

define HOST_SOURCE_RULE
$(call obj,host,$(1)): $(1) $(UNITS_DIR)/include/unit_abi.h
	@mkdir -p $$(dir $$@)
	$(if $(filter %.c,$(1)),$(HOST_CC) $(HOST_FLAGS) -std=gnu11 $(EXTRA_CFLAGS),$(HOST_CXX) $(HOST_FLAGS) -std=gnu++14 $(EXTRA_CXXFLAGS)) -c -o $$@ $$<
endef
$(foreach s,$(HOST_SRCS) $(BUILD)/host/bundle.c $(UNITS_DIR)/tools/unittest.c $(UNITS_DIR)/tools/describe.c,$(eval $(call HOST_SOURCE_RULE,$(s))))

$(BUILD)/host/unittest: $(foreach s,$(HOST_SRCS) $(BUILD)/host/bundle.c $(UNITS_DIR)/tools/unittest.c,$(call obj,host,$(s)))
	$(HOST_CXX) $(HOST_FLAGS) -o $@ $^

test: $(BUILD)/host/unittest
	$(BUILD)/host/unittest $(TEST_ARGS)

# `make describe`: the plugins and their parameters as JSON (tools/describe.c), for a store or a
# faceplate preview: $(BUILD)/describe.json.
$(BUILD)/host/describe: $(foreach s,$(HOST_SRCS) $(BUILD)/host/bundle.c $(UNITS_DIR)/tools/describe.c,$(call obj,host,$(s)))
	$(HOST_CXX) $(HOST_FLAGS) -o $@ $^

$(BUILD)/describe.json: $(BUILD)/host/describe
	$< > $@

describe: $(BUILD)/describe.json

clean:
	rm -rf $(BUILD)

.PHONY: all clean test describe FORCE $(MACHINES) $(foreach m,$(MACHINES),disasm-$(m))
